#!/bin/sh
#
# One commit, one wiki.
#
# Blocks a commit that touches two or more wikis, so separate threads of
# work never land in a single commit. A top-level folder counts as a wiki
# only if it holds its own AGENTS.md, in the working tree or in HEAD.
# These never count: top-level files, _shared/, archetypes/, git-hooks/,
# scripts/, docs/, examples/, dotfolders, and any folder starting with "_".
#
# Install or reinstall:      sh git-hooks/install.sh
# Cross wikis on purpose:    git commit --no-verify
#
set -u

# --no-renames lists both sides of a move, so moving a page between wikis counts.
staged=$(git diff --cached --name-only --no-renames)
[ -n "$staged" ] || exit 0

dirs=$(printf '%s\n' "$staged" | awk -F/ 'NF > 1 { print $1 }' | sort -u)

wikis=""
count=0
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  case "$dir" in
    _*|.*|archetypes|git-hooks|scripts|docs|examples) continue ;;
  esac
  if [ -f "$dir/AGENTS.md" ] || git cat-file -e "HEAD:$dir/AGENTS.md" 2>/dev/null; then
    wikis="$wikis $dir"
    count=$((count + 1))
  fi
done <<EOF
$dirs
EOF

[ "$count" -gt 1 ] || exit 0

{
  echo "Commit blocked: it touches more than one wiki:"
  for w in $wikis; do echo "    $w/"; done
  echo ""
  echo "Commit each wiki on its own:"
  echo "    git reset"
  for w in $wikis; do echo "    git add $w/ && git commit -m \"$w: <what changed>\""; done
  echo ""
  echo "Crossing wikis on purpose? Run: git commit --no-verify"
} >&2
exit 1
